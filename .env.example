# Admin login. Run `npm run admin:password` to generate the password and its hash.
ADMIN_USERNAME=your-username
ADMIN_PASSWORD_HASH=

# Signs login sessions. At least 32 characters. Changing it logs out every session.
SESSION_SECRET=

# Database. Leave both unset locally to use the local.db file. Required on Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# File uploads. Leave unset locally to save into public/uploads. Required on Vercel.
BLOB_READ_WRITE_TOKEN=

# Your public address, used in link previews. Vercel's production address is used if unset.
NEXT_PUBLIC_SITE_URL=
